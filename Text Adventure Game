      if (rooms[currentColumn][currentRow].equals("Treasure"))
      {
        if (hasKey == true)
        {
        System.out.println("You have found the sacred treasure! You win!");
        break;
        }
        else
        {
         System.out.println("Before you is a MASSIVE golden door, although the color is a bit FADED. There seems to be a key hole, maybe you should find that first. You walk back to where you repelled down."); 
          currentRow = 2;
          currentColumn = 3;
         }
      }
      if (rooms[currentColumn][currentRow].equals("Key"))
      {
        System.out.println("You found a key! This surely leads to a special place.");
      }
    }
  }
}
