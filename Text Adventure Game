          currentColumn = 3;
          hasSword = false;
          hasShield = false;
          hasMap = false;
          hasKey = false;
        }
      }
      if (rooms[currentColumn][currentRow].equals("Map"))
      {
        System.out.println("You find a chest in the middle of another empty room. You open it and see a seemingly endless amount of maps! Taking one won't hurt.");
