    rooms[6][4] = "Spikes";
    
    boolean hasSword = false;
    boolean hasShield = false;
    boolean hasMap = false;
    boolean hasKey = false;
    int currentRow = 2;
    int currentColumn = 3;
    Scanner scan = new Scanner(System.in);
    
    while (true)
    {
      System.out.println("Current Room: " + rooms[currentColumn][currentRow]);
      System.out.println("Which direction would you like to go?");
      String direction = scan.nextLine().toUpperCase();
      if (direction.equals("NORTH"))
      {
        currentRow--;
      }
      if (direction.equals("EAST"))
      {
        currentColumn++;
      }
      if (direction.equals("SOUTH"))
      {
        currentRow++;
      }
      if (direction.equals("WEST"))
      {
        currentColumn--;
      }
      if (direction.equals("MAP") && hasMap == true)
      {
                     System.out.println("           Treasure");
                    System.out.println("             Arrows");
                    System.out.println("Spikes   Sword   Direction   Shield   Spikes");
                    System.out.println("Spikes   Map     Direction   Enemy    Key");
                    System.out.println("         Spikes Spikes       Spikes   Spikes");
        }
      if (direction.equals("MAP") && hasMap != true)
      {
        System.out.println("You look around in your pockets and can't find your map! You must have left it at home. Maybe there's another one lying around somewhere...");
      }
      
      
      
      if (rooms[currentColumn][currentRow].equals("Spikes"))
      {
        System.out.println("You fell into a spike trap and were impaled to death! You have respawned.");
        currentRow = 2;
        currentColumn = 3;
        hasSword = false;
        hasShield = false;
        hasMap = false;
        hasKey = false;
      }
      if (rooms[currentColumn][currentRow].equals("Direction"))
      {
        if (currentRow == 2 && currentColumn == 3)
        {
          System.out.println("You're at where you repelled down into the dungeon.");
        }
        else 
        {
        System.out.println("There's nothing in this room. Keep searching for tools!");
        }
      }
      if (rooms[currentColumn][currentRow].equals("Sword"))
      {
        System.out.println("You find a chest in the middle of another empty room. You open it and see a seemingly endless amount of swords! Taking one won't hurt.");
        hasSword = true;
      }
      if (rooms[currentColumn][currentRow].equals("Shield"))
      {
        System.out.println("You find a chest in the middle of another empty room. You open it and see a seemingly endless amount of shields! Taking one won't hurt.");
        hasShield = true;
      }
      if (rooms[currentColumn][currentRow].equals("Arrows"))
      {
        if (hasShield == true)
        {
          System.out.println("A volley arrow shoots out from the walls! Using your shield, you manage to block the ones coming at you. You're safe for now. Make sure to be careful in future rooms.");
        }
        else {
          System.out.println("A volley arrow shoots out from the walls! Without anything to block yourself, you are impaled by them and die! You have respawned.");
          currentRow = 2;
          currentColumn = 3;
          hasSword = false;
          hasShield = false;
          hasMap = false;
          hasKey = false;
        }
      }
      if (rooms[currentColumn][currentRow].equals("Enemy"))
      {
        if (hasSword == true)
        {
          System.out.println("Entering the room, you see a hoard of enemies! Using your sword, you manage to slay all of them. You're safe for now. Make sure to be careful in future rooms.");
        }
        else {
          System.out.println("Entering the room, you see a hoard of enemies! Without anything to defend yourself, the enemies manage to overwhelm and kill you! You have respawned.");
