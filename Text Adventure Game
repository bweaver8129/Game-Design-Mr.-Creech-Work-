import java.util.Scanner;

public class Main {
  public static void main(String[] args)
  {
    String[][] rooms = new String[7][6];
    String[] directions = {"NORTH", "EAST", "SOUTH", "WEST"};
    rooms[0][4] = "Spikes";
    rooms[1][3] = "Spikes";
    rooms[1][4] = "Map";
    rooms[1][5] = "Spikes";
    rooms[2][2] = "Spikes";
    rooms[2][3] = "Sword";
    rooms[2][4] = "Arrows";
    rooms[2][5] = "Spikes";
    rooms[3][0] = "Treasure";
    rooms[3][1] = "Arrows";
    rooms[3][2] = "Direction"; //Spawn room
    rooms[3][3] = "Direction";
